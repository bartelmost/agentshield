    "let me audit you",
    "security check",
    "run audit",
    "check my certificate"
  ],
  "features": [
    "Ed25519 challenge-response authentication",
    "Rate limiting: 3 free audits/hour",
    "Real Secret Leakage test with 15+ patterns",
    "4 additional security tests (mock in v6.1)",
    "Cryptographically signed certificates",
    "Certificate Store (SQLite/PostgreSQL)",
    "Public verification endpoint",
    "90-day certificate validity",
    "3 security tiers: HARDENED/PROTECTED/BASIC",
    "Auto-detection of agent info",
    "Token optimization reports",
    "Code security scanning"
  ],
  "endpoints": {
    "health": "/api/health",
    "rate_limit_status": "/api/rate-limit/status",
    "agent_audit_initiate": "/api/agent-audit/initiate",
    "agent_audit_challenge": "/api/agent-audit/challenge",
    "agent_audit_complete": "/api/agent-audit/complete",
